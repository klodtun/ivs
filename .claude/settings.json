{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ivs-guard.sh\"",
            "timeout": 10,
            "statusMessage": "ตรวจคำสั่งก่อนรัน"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ivs-state.sh\"",
            "timeout": 20,
            "statusMessage": "อ่านสถานะเครื่อง iVS"
          }
        ]
      }
    ]
  }
}
